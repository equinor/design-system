# Match the Node.js version pinned in .nvmrc and .node-version
FROM docker.io/node:24.22.1-alpine AS build

LABEL org.opencontainers.image.title="EDS Demo Application"
LABEL org.opencontainers.image.description="Equinor Design System beta tokens demo"
LABEL org.opencontainers.image.source="https://github.com/equinor/design-system"

WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm@11.27.0

# Copy everything
COPY . ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build the demo as a static site in apps/eds-demo/out. The workspace packages
# are not built: the demo installs eds-tokens, eds-core-react and eds-icons
# from npm.
RUN pnpm --filter eds-demo run build && \
    test -s apps/eds-demo/out/index.html && \
    test -s apps/eds-demo/out/preview/index.html

# Use unprivileged nginx image for better security
FROM nginxinc/nginx-unprivileged:stable-alpine

# Copy the static site with proper ownership
COPY --chown=101 --from=build /app/apps/eds-demo/out/ /usr/share/nginx/html/

# Copy nginx configuration
COPY ./eds-demo-nginx.conf /etc/nginx/conf.d/default.conf

# Use the nginx user (UID 101)
USER 101

EXPOSE 3000

# Default nginx command (nginx-unprivileged runs in foreground by default)
