{
    "expo": {
        "name": "EDS Mobile",
        "slug": "mobile-storybook",
        "version": "0.2.0",
        "orientation": "portrait",
        "icon": "./assets/images/eDS_Logo_Light.png",
        "scheme": "mobile-storybook",
        "userInterfaceStyle": "automatic",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.equinor.eds.mobile",
            "buildNumber": "1",
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/eDS_Logo_Light.png",
                "backgroundColor": "#ffffff"
            }
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/eDS_Logo_Light.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/eDS_Logo_Light.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff"
                }
            ],
            "expo-font",
            "expo-image",
            "expo-web-browser"
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
