{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "tag-separator": "@",
  "packages": {
    "apps/mobile-storybook": {
      "release-type": "expo",
      "component": "mobile-storybook"
    },
    "packages/eds-core-react": {
      "release-type": "node",
      "package-name": "@equinor/eds-core-react",
      "component": "eds-core-react",
      "exclude-paths": [
        "packages/eds-core-react/src/components/next",
        "packages/eds-core-react/.storybook",
        "packages/eds-core-react/stories",
        "packages/eds-core-react/tests"
      ]
    },
    "packages/eds-core-react/src/components/next": {
      "release-type": "simple",
      "component": "eds-core-react-next",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta"
    },
    "packages/eds-data-grid-react": {
      "release-type": "node",
      "package-name": "@equinor/eds-data-grid-react",
      "component": "eds-data-grid-react",
      "exclude-paths": [
        "packages/eds-data-grid-react/.storybook",
        "packages/eds-data-grid-react/src/tests",
        "packages/eds-data-grid-react/src/stories"
      ]
    },
    "packages/eds-icons": {
      "release-type": "node",
      "package-name": "@equinor/eds-icons",
      "component": "eds-icons"
    },
    "packages/eds-lab-react": {
      "release-type": "node",
      "package-name": "@equinor/eds-lab-react",
      "component": "eds-lab-react",
      "exclude-paths": [
        "packages/eds-lab-react/.storybook",
        "packages/eds-lab-react/stories",
        "packages/eds-lab-react/src/stories"
      ]
    },
    "packages/eds-mobile-components": {
      "release-type": "node",
      "package-name": "@equinor/eds-mobile-components",
      "component": "eds-mobile-components"
    },
    "packages/eds-tokens": {
      "release-type": "simple",
      "package-name": "@equinor/eds-tokens",
      "component": "eds-tokens",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "exclude-paths": [
        "packages/eds-tokens/tokens",
        "packages/eds-tokens/build-generate-variables",
        "packages/eds-tokens/scripts",
        "packages/eds-tokens/.vscode"
      ]
    },
    "packages/eds-utils": {
      "release-type": "node",
      "package-name": "@equinor/eds-utils",
      "component": "eds-utils"
    }
  },
  "separate-pull-requests": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "✨ Added"
    },
    {
      "type": "fix",
      "section": "🐛 Fixed"
    },
    {
      "type": "docs",
      "section": "📝 Changed",
      "hidden": true
    },
    {
      "type": "perf",
      "section": "⚡ Performance Improvements"
    },
    {
      "type": "refactor",
      "section": "♻️ Refactoring"
    },
    {
      "type": "chore",
      "section": "🔧 Chores",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "👷 CI/CD",
      "hidden": true
    },
    {
      "type": "build",
      "section": "📦 Build System",
      "hidden": true
    },
    {
      "type": "test",
      "section": "✅ Tests",
      "hidden": true
    }
  ],
  "release-search-depth": 500,
  "changelog-path": "CHANGELOG.md",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "pull-request-title-pattern": "chore: release${component}",
  "pull-request-header": "## Release PR\n\nThis PR was automatically generated by release-please.\n\n✅ **What happens automatically when merged:**\n- 🚀 npm publish workflows triggered for changed packages\n- 📝 Versions bumped and CHANGELOGs updated\n- 🏷️ GitHub releases created automatically\n\n⚠️ **Manual steps required after merge:**\n1. Rebase main onto master\n2. Announce in #eds-design-system",
  "label": "autorelease: pending"
}
