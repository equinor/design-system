{
  "permissions": {
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Grep(./.env)",
      "Grep(./.env.*)",
      "Glob(**/.env*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Bash(*.env*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*id_ecdsa*)",
      "Bash(*id_dsa*)",
      "Bash(*.pem*)",
      "Bash(*credentials.json*)",
      "Bash(*secrets.json*)",
      "Bash(*secrets/*)",
      "Read(./id_rsa*)",
      "Read(./id_ed25519*)",
      "Read(./id_ecdsa*)",
      "Read(./id_dsa*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/read_hook.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_hook.js"
          }
        ]
      }
    ]
  }
}
