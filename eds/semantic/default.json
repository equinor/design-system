          "spread": "{shadow.low.key.spread}"
        },
        {
          "x": "{shadow.low.ambient.x}",
          "y": "{shadow.low.ambient.y}",
          "blur": "{shadow.low.ambient.blur}",
          "color": "{shadow.low.ambient.color}",
          "spread": "{shadow.low.ambient.spread}"
        }
      ],
      "$type": "shadow",
      "$description": "Low elevation — two-layer (key + ambient) shadow. Semantic face over the shadow.* parts in elevation/default, mirroring how spacing.* faces density.spacing.*."
