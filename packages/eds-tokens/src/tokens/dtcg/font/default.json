{
  "family": {
    "header": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-family-header)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_FAMILY"
          ]
        }
      },
      "$type": "fontFamily",
      "$value": "{primitives.font-family.equinor}"
    },
    "ui": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-family-ui)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_FAMILY"
          ]
        }
      },
      "$type": "fontFamily",
      "$value": "{primitives.font-family.inter}"
    }
  },
  "weight": {
    "bold": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-weight-bold)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_WEIGHT"
          ]
        }
      },
      "$type": "fontWeight",
      "$value": "{primitives.weight-scale.bold}"
    },
    "medium": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-weight-medium)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_WEIGHT"
          ]
        }
      },
      "$type": "fontWeight",
      "$value": "{primitives.weight-scale.medium}"
    },
    "normal": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-weight-normal)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_WEIGHT"
          ]
        }
      },
      "$type": "fontWeight",
      "$value": "{primitives.weight-scale.normal}"
    }
  }
}
