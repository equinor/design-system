{
  "family": {
    "header": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-family-header)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_FAMILY"
          ]
        }
      },
      "$type": "fontFamily",
      "$value": "{primitives.font-family.equinor}"
    },
    "ui": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-family-ui)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_FAMILY"
          ]
        }
      },
      "$type": "fontFamily",
      "$value": "{primitives.font-family.inter}"
    }
  },
  "weight": {
    "bolder": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-weight-bolder)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_WEIGHT"
          ]
        }
      },
      "$type": "fontWeight",
      "$value": "{primitives.weight-scale.bolder}"
    },
    "lighter": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-weight-lighter)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_WEIGHT"
          ]
        }
      },
      "$type": "fontWeight",
      "$value": "{primitives.weight-scale.lighter}"
    },
    "normal": {
      "$extensions": {
        "com.figma": {
          "codeSyntax": {
            "WEB": "var(--eds-weight-normal)"
          },
          "hiddenFromPublishing": true,
          "scopes": [
            "FONT_WEIGHT"
          ]
        }
      },
      "$type": "fontWeight",
      "$value": "{primitives.weight-scale.normal}"
    }
  }
}
