{
    "extends": "./tsconfig.json",
    // Overrides (not merges) the parent's include — adds jest.setup.ts and
    // test-utils.tsx, which live outside src/ so they're excluded from the
    // build, but still need to be lintable.
    "include": ["src", "jest.setup.ts", "test-utils.tsx"],
    // Overrides (not merges) the parent's exclude — intentionally drops the
    // Slice 2–4 component dirs so ESLint can parse them. Mirror any other
    // non-migration excludes added to tsconfig.json here.
    // Keep in sync with the files list in eslint.config.js.
    "exclude": ["dist", "node_modules", "**/*.spec.ts"],
    // TypeScript 6 no longer includes every @types package on its own, so the
    // Jest globals used by the tests and jest.setup.ts are listed here.
    "compilerOptions": { "types": ["jest"] }
}
